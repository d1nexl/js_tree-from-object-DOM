'use strict';
var food = {
    Drink: {
        Wine: {},
        Schnaps: {}
    },
    Fruit: {
        Red: {
            Cherry: {},
            Strawberry: {}
        },
        Yellow: {
            Banana: {},
            Pineapple: {}
        }
    }
};
var tree = document.querySelector('#tree');
function createTree(element, data) {
    var ul = document.createElement('ul');
    for(var key in data){
        var li = document.createElement('li');
        li.textContent = key;
        if (Object.keys(data[key]).length > 0) {
            var subTree = document.createElement('ul');
            createTree(subTree, data[key]);
            subTree.style.display = 'none';
            li.appendChild(subTree);
        }
        ul.appendChild(li);
    }
    element.appendChild(ul);
}
createTree(tree, food);
tree.addEventListener('click', function(e) {
    if (e.target.tagName === 'LI') {
        var subTree = e.target.querySelector('ul');
        if (subTree) {
            if (subTree.style.display === '' || subTree.style.display === 'none') subTree.style.display = 'block';
            else subTree.style.display = 'none';
        }
    }
});

